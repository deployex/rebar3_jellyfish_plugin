{erl_opts, [debug_info]}.

{deps, []}.

% project_plugins, not plugins: the latter would make rebar3_hex a
% dependency for anyone who installs this plugin from Hex.
{project_plugins, [rebar3_hex]}.

% This plugin only ever runs inside a rebar3 process, so it calls functions
% from the `rebar` and `providers` applications (rebar_state, rebar_app_info,
% rebar_dir, rebar_api, providers) without declaring them as deps - they're
% provided by the host rebar3 escript at runtime. xref has no way to know
% that, so undefined_function_calls/undefined_functions are left out here.
{xref_checks, [
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

